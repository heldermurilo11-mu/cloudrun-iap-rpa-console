ENVIRONMENT=local
AUTH_MODE=local
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
FIRESTORE_DATABASE=(default)
STORAGE_BUCKET=
IAP_EXPECTED_AUDIENCE=
IAP_ALLOWED_DOMAINS=example.com
IAP_ADMIN_EMAILS=admin@example.com
LOCAL_DEV_USER=developer@example.com
ALLOWED_DATAPOOL_PREFIXES=sample_queue_,datapools_staging
ALLOWED_JOBS=sample-producer-job,sample-consumer-job
ALLOWED_SCHEDULERS=cron-producer,cron-consumer
AUDIT_LOG_NAME=rpa-orchestrator-audit
AUDIT_FIRESTORE_COLLECTION=audit_trail
BOT_LOG_NAMES=rpa-bots-worker
EXECUTIONS_COLLECTION=executions
DEFAULT_TIMEZONE=UTC
